{
  "name": "asahi-notch-bar",
  "version": "1.0.0",
  "description": "GNOME Shell extension that fits the top bar to the Apple Silicon MacBook notch on Asahi Linux",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json",
    "lint": "eslint --max-warnings 0 . && shellcheck --severity=style tests/shell/*.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test --experimental-test-coverage --test-coverage-include=src/notch.ts --test-coverage-include=tools/zip.ts --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 \"tests/*.test.ts\"",
    "test:shell": "npm run build && tests/shell/run.sh",
    "pack": "npm run build && node tools/pack.ts",
    "extension:install": "npm run -s pack && gnome-extensions install --force \"$(ls dist/*.shell-extension.zip)\"",
    "clean": "rm -rf build dist",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@girs/gjs": "5.6.0",
    "@girs/gnome-shell": "51.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsdoc": "65.5.3",
    "eslint-plugin-tsdoc": "0.5.4",
    "jiti": "2.7.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swiftraccoon/asahi-notch-bar.git"
  },
  "overrides": {
    "eslint-plugin-tsdoc": {
      "@typescript-eslint/utils": "$typescript-eslint"
    }
  }
}
